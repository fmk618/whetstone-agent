# 复制为 .env.development(本地)或 .env.production(服务器),填入真实 Key。
# 切勿把含真实 Key 的文件提交到仓库。

# 运行环境: development | production
APP_ENV=development

# 服务商 API Key(与 config/providers.yaml 的 api_key_env 对应)
DASHSCOPE_API_KEY=          # 千问(阿里云百炼)
ARK_API_KEY=                # 豆包(火山方舟)
MOONSHOT_API_KEY=           # Kimi(Moonshot)
DEEPSEEK_API_KEY=           # DeepSeek
